#!/bin/bash

lock="🔒 lock screen"
logout="🚪 log out"
reboot="➰ reboot"
shut_down="🔌 shut down"

choice="$(echo "$lock
$logout
$reboot
$shut_down" | rofi -dmenu -p "power menu")"

case "$choice" in
  "$lock")
    if [[ $DESKTOP_SESSION =~ "hyprland" ]]; then
      sleep 0.5
      __NV_PRIME_RENDER_OFFLOAD=0 hyprlock
    else
      i3lock -i ~/.config/i3/wallpaper/warm_poly.png -t
    fi
    ;;
  "$logout")
    if [[ $DESKTOP_SESSION =~ "hyprland" ]]; then
      uwsm stop
    else
      i3-msg exit
    fi
    ;;
  "$reboot")
    systemctl reboot
    ;;
  "$shut_down")
    systemctl poweroff
    ;;
esac

